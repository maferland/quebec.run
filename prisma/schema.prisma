// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  isStaff       Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  clubs         Club[]
  organizations Organization[]
  consents      UserConsent[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model Club {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  website     String?
  instagram   String?
  facebook    String?
  language    String? // 'fr', 'en', or 'both'

  // Strava integration
  stravaClubId String?   @unique
  stravaSlug   String?   @unique
  isManual     Boolean   @default(true)
  lastSynced   DateTime?

  // Display settings
  isActive Boolean @default(true) // paused = false

  // Categorization (for filters)
  type             ClubType?
  vibe             ClubVibe?
  paceMin          String? // e.g., "5:00" min/km
  paceMax          String? // e.g., "7:00" min/km
  beginnerFriendly Boolean   @default(false)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String

  // Organization (optional during migration, will become required)
  organizationId String?

  // Relations
  owner           User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events          Event[]          @relation("ClubEvents")
  recurringEvents RecurringEvent[]
  addresses       Address[]        @relation("ClubAddresses")

  @@map("clubs")
}

model RecurringEvent {
  id          String  @id @default(cuid())
  slug        String
  title       String
  description String?

  // Location
  address      String?
  placeName    String?
  latitude     Float?
  longitude    Float?
  neighborhood String?

  // Event details
  distance   String?
  pace       String?
  pacePolicy PacePolicy?

  // Schedule
  schedulePattern String
  timezone        String @default("America/Toronto")

  // Generation control
  isActive      Boolean   @default(true)
  generateUntil DateTime?

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  clubId    String

  // Relations
  club            Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  generatedEvents Event[]

  @@unique([clubId, slug])
  @@index([clubId])
  @@index([isActive])
  @@map("recurring_events")
}

model Event {
  id          String  @id @default(cuid())
  title       String
  // Public handle for one-off events; occurrences of a pattern are addressed
  // through their recurring slug instead, so theirs stays null.
  slug        String? @unique
  description String?

  // Location
  address      String?
  placeName    String?
  latitude     Float?
  longitude    Float?
  neighborhood String?
  geocodedAt   DateTime?

  // Event timing
  date DateTime
  time String

  // Event details
  distance   String?
  pace       String?
  pacePolicy PacePolicy?

  // Status (for cancellations)
  status EventStatus @default(SCHEDULED)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Club or Organization (event belongs to one or the other)
  clubId         String?
  organizationId String?

  // Recurring event link
  recurringEventId String?

  // Relations
  club           Club?           @relation("ClubEvents", fields: [clubId], references: [id], onDelete: Cascade)
  organization   Organization?   @relation("OrganizationEvents", fields: [organizationId], references: [id], onDelete: Cascade)
  recurringEvent RecurringEvent? @relation(fields: [recurringEventId], references: [id], onDelete: SetNull)

  @@index([clubId])
  @@index([recurringEventId])
  @@index([date])
  @@index([status])
  @@map("events")
}

model UserConsent {
  id         String   @id @default(cuid())
  userId     String   @unique
  acceptedAt DateTime @default(now())
  ipAddress  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_consents")
}

// =============================================================================
// Organization / Club Hierarchy
// =============================================================================

model Organization {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  description String?
  website     String?
  instagram   String?
  facebook    String?

  // Strava integration (for event-only orgs that are Strava clubs)
  stravaClubId String? @unique
  stravaSlug   String?

  // Display settings
  isVisible Boolean @default(false) // false for simple clubs (hidden org)

  // Metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ownerId   String

  // Relations
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  clubs     Club[]
  events    Event[]   @relation("OrganizationEvents")
  addresses Address[] @relation("OrganizationAddresses")

  @@map("organizations")
}

model Address {
  id        String @id @default(cuid())
  label     String // "Main spot", "Alternate", etc.
  address   String
  latitude  Float?
  longitude Float?

  // Belongs to either club or org (not both)
  clubId         String?
  organizationId String?

  createdAt DateTime @default(now())

  // Relations
  club         Club?         @relation("ClubAddresses", fields: [clubId], references: [id], onDelete: Cascade)
  organization Organization? @relation("OrganizationAddresses", fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// =============================================================================
// Enums
// =============================================================================

enum ClubType {
  TRAIL
  ROAD
  TRACK
  MIXED
}

enum ClubVibe {
  SOCIAL
  TRAINING
  COMPETITIVE
}

enum EventStatus {
  SCHEDULED
  CANCELLED
}

enum PacePolicy {
  SHARED
  OPEN_PACE
}
