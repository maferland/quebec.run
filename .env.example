# Server
PORT=3000

# Database
DATABASE_URL="postgresql://username:password@localhost:5432/courses?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-32-character-secret-key-here"
# NEXTAUTH_URL auto-constructed from PORT (defaults to http://localhost:3000)
# Override only in production: NEXTAUTH_URL="https://yourdomain.com"

# Email configuration
EMAIL_FROM="noreply@yourdomain.com"
USE_RESEND=false

# Development (Mailhog) - used when USE_RESEND=false
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1026"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""

# Mailhog Docker ports (optional, for docker-compose)
MAILHOG_SMTP_PORT=1026
MAILHOG_WEB_PORT=8026

# Production (Resend) - required when USE_RESEND=true or NODE_ENV=production
# Get your API key from https://resend.com/api-keys
# RESEND_API_KEY="re_your_api_key_here"


# Strava API (get from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID="your-client-id"
STRAVA_CLIENT_SECRET="your-client-secret"
STRAVA_REFRESH_TOKEN="your-refresh-token"
# Note: Access token will be auto-refreshed (expires every 6 hours)
